#!/usr/bin/env bash
# __NS__-tick.sh — one outer-loop tick of the "__NS__" namespace loop: sync this
# loop's dedicated infra worktree to main, then dispatch.
#
# Generated by /define-loop as a clone of harness-tick.sh. This is the target the
# "__NS__" loop's /loop session invokes — NOT the dispatcher directly.
#
# WHY A WRAPPER. __NS__-dispatch.sh, harness-lib.sh, and .harness/env all live in
# this loop's dedicated infra worktree (../<repo>-harness-ns-__NS__) and are read
# FROM it as the loop runs. That worktree sits at a detached HEAD and does NOT
# auto-advance when main moves, so without a sync step the loop infra would freeze.
# Feature PIPELINE skills are unaffected — they run inside per-feature worktrees
# that branch off main and pick up updates on their own.
#
# WHY ITS OWN WORKTREE. An intent-sourced loop spawns per-feature worktrees (like
# the build loop), so it can't share the build loop's host worktree without racing
# its per-tick force-sync. Its own infra worktree + its own flock (in the
# dispatcher) keeps the two fully independent; they coordinate only through git.
#
# WHY HERE AND NOT IN THE DISPATCHER. If the dispatcher reset its own checkout
# mid-run it would overwrite the very file it's executing (its flock is on $0).
# Syncing HERE, before exec, means the dispatcher always loads its freshest version.

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."   # repo root of this loop's infra worktree

git fetch --quiet origin

# Force a clean, current detached checkout of origin/main. Idempotent + self-healing.
git checkout --quiet -f --detach origin/main
git clean -qfd                            # -d not -x: keep node_modules & .harness/* runtime state

exec ./scripts/__NS__-dispatch.sh "$@"
