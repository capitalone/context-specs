#!/usr/bin/env bash
# __NS__-dispatch.sh — one tick of the "__NS__" namespace loop.
#
# Generated by /define-loop as a clone of poll-and-dispatch.sh (the prd build
# loop). Same substrate, same invariants (1–9), same shared harness-lib.sh — the
# ONLY differences are the namespace: this loop watches `__NS__/<slug>/*`, claims
# into `feature/__NS__/<f>`, and runs in its own dedicated infra worktree
# `<repo>-harness-ns-__NS__` so it never races the build loop's host sync.
#
# Deterministic bash. NO LLM in the decision path. The if/elif chain in the
# advance loop IS the state machine; the artifacts on disk ARE the state. When
# this script and the design invariants disagree, the invariants win.
#
# Safe to edit. See define-loop's references/dispatcher-clone-guide.md for exactly
# which lines carry the namespace and how to add/remove pipeline phases.

# Serialize against concurrent ticks on this node. (Inv 5) Own $0 = own flock, so
# this never waits on the build loop or the memory loop.
exec {lockfd}<"$0"; flock -n $lockfd || exit 0

set -euo pipefail

# The one namespace knob. Everything below derives from it. (Set by /define-loop.)
NS="__NS__"

SLUG="$(git config user.email | cut -d@ -f1)"
WATCH="${WATCH_PATTERN:-${NS}/${SLUG}/*}"
# Derive the repo name from the MAIN worktree (always first in `git worktree list`),
# NOT $PWD: this dispatcher runs from the detached '<repo>-harness-ns-__NS__' infra
# worktree. Per-feature worktrees are '<repo>-harness-ns-__NS__-<feature>'; the infra
# worktree is '<repo>-harness-ns-__NS__' (re-synced each tick by __NS__-tick.sh). The
# '-ns-' infix keeps this clear of the build loop's '<repo>-harness-<feature>' paths.
MAIN_WT="$(git worktree list --porcelain | sed -n '1s/^worktree //p')"
WORKTREE_BASE="../$(basename "${MAIN_WT:-$PWD}")-harness-ns-${NS}"
MAX_WORKTREES="${MAX_WORKTREES:-1}"
PLANNING_CAP="${PLANNING_CAP:-2}"
VALIDATE_CAP="${VALIDATE_CAP:-2}"
IMPLEMENT_CAP="${IMPLEMENT_CAP:-3}"
LOCAL_CHECKS_CAP="${LOCAL_CHECKS_CAP:-2}"
FEEDBACK_CAP="${FEEDBACK_CAP:-5}"
REVIEW_CLEAN_MARKER="${REVIEW_CLEAN_MARKER:-HARNESS_REVIEW_CLEAN}"
mkdir -p .harness

# Headless permission posture for `claude -p`. See poll-and-dispatch.sh for the
# full rationale; override in .harness/env (sourced below) if needed.
CLAUDE_PERM_ARGS=( --permission-mode auto )

# Load project-local config (MAX_WORKTREES, WATCH_PATTERN, CLAUDE_PERM_ARGS, ...).
[[ -f .harness/env ]] && source .harness/env

# Shared helpers (worktree_for, bootstrap_worktree, run_claude,
# render_sessions_table) — the SAME harness-lib.sh the build + memory loops use.
source "$(dirname "${BASH_SOURCE[0]}")/harness-lib.sh"

# Invariant 2: a feature/__NS__/<f> is loop-owned iff prds/<f>/prd.md is committed
# to it. The minter (/intent-__NS__) writes the same prds/<feature>/ layout, so the
# whole downstream chain (spec-planning, …) is reused unchanged.
has_prd() {
  git cat-file -e "origin/feature/${NS}/${1}:prds/${1}/prd.md" 2>/dev/null
}

# Convergence handoff: reviewer reported no Important findings → the PR is the
# human's to evaluate. (NOT a failure — healthy terminal state of the review loop.)
signal_human_review() {
  local feature="$1" branch="feature/${NS}/${feature}"
  local body=".harness/human-review-body-${feature}.md"
  {
    echo "## Ready for your review"
    echo
    echo "The reviewer reports no outstanding Important findings. This PR is now"
    echo "yours to **evaluate** — run \`/evaluate-pr ${feature}\` to walk the change,"
    echo "run it locally, and build a firm understanding before you merge."
    echo
    echo "**Build sessions** (the full \`claude -p\` trail — open a trace at"
    echo "\`~/.claude/projects/<encoded>/<session-id>.jsonl\`):"
    echo
    render_sessions_table "$feature"
  } > "$body"
  gh pr comment "$branch" --body-file "$body" 2>/dev/null || true
}

# Signal STUCK to the human via the PR. Opens a draft PR if none exists yet.
signal_stuck() {
  local feature="$1" step="$2" cap="$3" output_file="${4:-}"
  touch ".harness/stuck-${feature}"
  local branch="feature/${NS}/${feature}"
  local body=".harness/stuck-body-${feature}.md"
  {
    echo "## STUCK — your turn"
    echo
    echo "**Loop:** \`${NS}\`  **Step:** \`/${step}\` — cap reached after ${cap} attempts."
    echo
    echo "**Sessions** (failing step + upstream chain — open the trace files in"
    echo "\`~/.claude/projects/<encoded-project>/<session-id>.jsonl\`):"
    echo
    if [[ -f ".harness/sessions-${feature}.tsv" ]]; then
      render_sessions_table "$feature"
      echo
    fi
    if [[ -s "$output_file" ]]; then
      echo "**Last 30 lines of failing output:**"
      echo
      echo '```'
      tail -n 30 "$output_file"
      echo '```'
      echo
    fi
    echo "## Diagnosis-first"
    echo
    echo "Your **first** job is not the code — it is to identify which piece of"
    echo "context (\`AGENTS.md\`, an Expert shard, a spec, the PRD, or this loop's"
    echo "\`loops/${NS}/\` template/oracle) misled the agent or was missing. Correct"
    echo "it on this branch *before* the code fix; the merge carries both into main."
    echo
    echo "- [ ] **Context defect identified:** \`<file:line>\` — \`<one-line>\`"
    echo "- [ ] Corrected the context on this branch"
    echo "- [ ] Code fixed; \`./prds/${feature}/run-prd-test.sh\` passes locally"
    echo "- [ ] Ready to merge"
  } > "$body"
  if gh pr view "$branch" >/dev/null 2>&1; then
    gh pr comment "$branch" --body-file "$body" 2>/dev/null || true
  else
    gh pr create --base main --head "$branch" --draft \
                 --title "STUCK: ${NS}/${feature} (${step})" --body-file "$body" 2>/dev/null || true
  fi
}

# Has the reviewer signalled "done"? True iff any PR comment contains the marker.
# gh's --jq is a lightweight filter (no --arg); pull bodies and fixed-string match.
reviewer_converged() {
  local branch="$1"
  [[ -n "$REVIEW_CLEAN_MARKER" ]] || return 1
  gh pr view "$branch" --json comments --jq '.comments[]?.body' 2>/dev/null \
    | grep -qF "$REVIEW_CLEAN_MARKER"
}

git fetch --quiet origin

# 1. Re-attach worktrees for in-flight feature/__NS__/* that lost theirs. In-flight
#    work always continues regardless of MAX_WORKTREES — the cap is on NEW intake.
#    lstrip=5 strips 'refs/remotes/origin/feature/__NS__' → leaves the bare <f>.
in_flight=()
for feature in $(git for-each-ref --sort=committerdate \
                   --format='%(refname:lstrip=5)' \
                   "refs/remotes/origin/feature/${NS}/" 2>/dev/null || true); do
  has_prd "$feature" || continue
  # Liveness gate: a MERGED/CLOSED PR means DONE; skip so step 2 reclaims the slot
  # and step 3 doesn't re-poke it. Empty state (pre-PR phase / transient gh failure)
  # is fail-SAFE: keep in-flight. Merged is terminal → never rewinds. (Inv 9)
  pr_state="$(gh pr view "feature/${NS}/${feature}" --json state --jq .state 2>/dev/null || echo "")"
  [[ "$pr_state" == "MERGED" || "$pr_state" == "CLOSED" ]] && continue
  wt="$(worktree_for "$feature")"
  if [[ ! -d "$wt" ]]; then
    git worktree add "$wt" "feature/${NS}/${feature}" 2>/dev/null && bootstrap_worktree "$wt" || true
  fi
  [[ -d "$wt" ]] && in_flight+=("$feature")
done

# 2. Claim new work-items up to remaining capacity (lazy claim). Over cap stay in
#    __NS__/<slug>/* as the visible queue. The atomic rename is the claim lock:
#    push the __NS__/<slug>/<f> commit as feature/__NS__/<f> AND delete the source
#    ref in one push. Non-fast-forward = another node won; skip silently. (Inv 2 + 7)
capacity=$(( MAX_WORKTREES - ${#in_flight[@]} ))
if (( capacity > 0 )); then
  for branch in $(git for-each-ref --sort=committerdate \
                    --format='%(refname:lstrip=3)' \
                    "refs/remotes/origin/${WATCH}" 2>/dev/null || true); do
    (( capacity > 0 )) || break
    feature="${branch##*/}"
    if git push origin "origin/${branch}:refs/heads/feature/${NS}/${feature}" \
                       ":refs/heads/${branch}" 2>/dev/null; then
      wt="$(worktree_for "$feature")"
      git worktree add "$wt" "feature/${NS}/${feature}" 2>/dev/null && bootstrap_worktree "$wt" || true
      in_flight+=("$feature")
      capacity=$(( capacity - 1 ))
    fi
  done
fi

# 3. Advance each active feature by exactly ONE step. (Inv 5)
for feature in ${in_flight[@]+"${in_flight[@]}"}; do
  wt="$(worktree_for "$feature")"
  [[ -d "$wt" ]] || continue
  branch="feature/${NS}/${feature}"

  # STUCK guard: a cap-hit handed this feature to the human via the PR.
  [[ -f ".harness/stuck-${feature}" ]] && continue

  # HUMAN_REVIEW guard: reviewer converged; halt until the human merges/closes.
  if [[ -f ".harness/human-review-${feature}" ]]; then
    if [[ ! -f ".harness/human-review-posted-${feature}" ]]; then
      signal_human_review "$feature"
      touch ".harness/human-review-posted-${feature}"
    fi
    continue
  fi

  # Inv 3 guard: worktree HEAD must match the branch we're advancing.
  current=$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
  [[ "$current" == "$branch" ]] || continue

  # Wipe: discard uncommitted state from any crashed skill. -fd (not -fdx) keeps
  # gitignored deps like node_modules. (Inv 1 + 6)
  ( cd "$wt" \
    && git reset --hard HEAD --quiet \
    && git clean -fd --quiet \
    && git reset --hard "origin/$branch" --quiet )

  # State machine: walk forward by exactly one step. Sentinel files gate each
  # transition. Every step has a bounded retry; at cap, signal_stuck. The phases
  # below are the default proven chain — /define-loop edits this block per the
  # interview (add/remove an elif + its <step>_CAP). See dispatcher-clone-guide.md.
  if   [[ ! -f "${wt}/specs/${feature}/.planning-done" ]]; then
       attempts_file=".harness/planning-attempts-${feature}"
       attempts=$(cat "${attempts_file}" 2>/dev/null || echo 0)
       if (( attempts >= PLANNING_CAP )); then
         echo "STUCK: ${NS}/${feature} at /spec-planning (${PLANNING_CAP}x)." >&2
         signal_stuck "$feature" "spec-planning" "$PLANNING_CAP"
       else
         echo $((attempts + 1)) > "${attempts_file}"
         run_claude spec-planning "$feature" $((attempts + 1)) "$wt" "/spec-planning ${feature}"
       fi

  elif [[ ! -f "${wt}/specs/${feature}/.validated" ]]; then
       attempts_file=".harness/validate-attempts-${feature}"
       attempts=$(cat "${attempts_file}" 2>/dev/null || echo 0)
       if (( attempts >= VALIDATE_CAP )); then
         echo "STUCK: ${NS}/${feature} at /spec-validate (${VALIDATE_CAP}x)." >&2
         signal_stuck "$feature" "spec-validate" "$VALIDATE_CAP"
       else
         echo $((attempts + 1)) > "${attempts_file}"
         run_claude spec-validate "$feature" $((attempts + 1)) "$wt" "/spec-validate ${feature}"
       fi

  elif [[ ! -f "${wt}/specs/${feature}/.prd-passed" ]]; then
       # The ORACLE gate. Hard + judge-capable + sentinel-cached: run the work-item's
       # runner once until it first goes green, then cache a committed sentinel so an
       # LLM-judge runner isn't re-run every tick and can't non-deterministically
       # re-kick implement. Forward-only (Inv 9); CI/reviewer/human cover regressions.
       if ( cd "${wt}" && "./prds/${feature}/run-prd-test.sh" ); then
         ( cd "${wt}" \
           && touch "specs/${feature}/.prd-passed" \
           && git add "specs/${feature}/.prd-passed" \
           && git commit -m "harness: oracle green for ${NS}/${feature}" --quiet \
           && git push --quiet ) || true
       else
         attempts_file=".harness/implement-attempts-${feature}"
         attempts=$(cat "${attempts_file}" 2>/dev/null || echo 0)
         if (( attempts >= IMPLEMENT_CAP )); then
           ( cd "${wt}" && ./prds/${feature}/run-prd-test.sh ) > ".harness/stuck-output-${feature}.log" 2>&1 || true
           echo "STUCK: ${NS}/${feature} at /implement-mainspec — oracle ${IMPLEMENT_CAP}x." >&2
           signal_stuck "$feature" "implement-mainspec" "$IMPLEMENT_CAP" ".harness/stuck-output-${feature}.log"
         else
           echo $((attempts + 1)) > "${attempts_file}"
           run_claude implement-mainspec "$feature" $((attempts + 1)) "$wt" "/implement-mainspec ${feature}"
         fi
       fi

  elif [[ -x "${wt}/scripts/local-checks.sh" ]] \
       && ! ( cd "${wt}" && ./scripts/local-checks.sh ); then
       # Baseline hard floor beneath the oracle: auto-fix (attempt 0), focused LLM fix
       # (attempt 1), then STUCK. Optional — no script = gate skipped. (Inv 8)
       attempts_file=".harness/local-check-attempts-${feature}"
       attempts=$(cat "${attempts_file}" 2>/dev/null || echo 0)
       if (( attempts >= LOCAL_CHECKS_CAP )); then
         ( cd "${wt}" && ./scripts/local-checks.sh ) > ".harness/stuck-output-${feature}.log" 2>&1 || true
         echo "STUCK: ${NS}/${feature} at local-checks (${LOCAL_CHECKS_CAP}x)." >&2
         signal_stuck "$feature" "local-checks" "$LOCAL_CHECKS_CAP" ".harness/stuck-output-${feature}.log"
       elif (( attempts == 0 )); then
         ( cd "${wt}" && ./scripts/local-checks.sh fix || true )
         if ! ( cd "${wt}" && git diff --quiet ); then
           ( cd "${wt}" \
             && git commit -am "chore: auto-fix lint/format" --quiet \
             && git push --quiet )
         fi
         echo 1 > "${attempts_file}"
       else
         run_claude fix-local-checks "$feature" $((attempts + 1)) "$wt" "/fix-local-checks ${feature}"
         echo $((attempts + 1)) > "${attempts_file}"
       fi

  elif ! gh pr view "${branch}" >/dev/null 2>&1; then
       gh pr create --base main --head "${branch}" --fill
       rm -f ".harness/planning-attempts-${feature}"
       rm -f ".harness/validate-attempts-${feature}"
       rm -f ".harness/local-check-attempts-${feature}"
       rm -f ".harness/implement-attempts-${feature}"
       [[ -z "$REVIEW_CLEAN_MARKER" ]] && touch ".harness/human-review-${feature}"

  elif reviewer_converged "${branch}"; then
       touch ".harness/human-review-${feature}"

  elif gh pr view "${branch}" --json reviews \
         --jq '.reviews[] | select(.state=="CHANGES_REQUESTED" or .state=="COMMENTED")' \
         2>/dev/null | grep -q .; then
       rounds_file=".harness/feedback-rounds-${feature}"
       rounds=$(cat "${rounds_file}" 2>/dev/null || echo 0)
       if (( rounds >= FEEDBACK_CAP )); then
         echo "STUCK: ${NS}/${feature} at PR review (${FEEDBACK_CAP} rounds)." >&2
         signal_stuck "$feature" "address-feedback" "$FEEDBACK_CAP"
       else
         echo $((rounds + 1)) > "${rounds_file}"
         run_claude address-feedback "$feature" $((rounds + 1)) "$wt" "/address-feedback ${feature}"
       fi
  fi
done

# 4. Cleanup pass: tear down per-feature worktree + counters for closed/merged PRs.
for feature in $(git for-each-ref --format='%(refname:lstrip=5)' \
                   "refs/remotes/origin/feature/${NS}/" 2>/dev/null || true); do
  state=$(gh pr view "feature/${NS}/${feature}" --json state --jq .state 2>/dev/null || echo "")
  if [[ "${state}" == "MERGED" || "${state}" == "CLOSED" ]]; then
    git worktree remove "$(worktree_for "$feature")" --force 2>/dev/null || true
    rm -f ".harness/feedback-rounds-${feature}"
    rm -f ".harness/local-check-attempts-${feature}"
    rm -f ".harness/implement-attempts-${feature}"
    rm -f ".harness/planning-attempts-${feature}"
    rm -f ".harness/validate-attempts-${feature}"
    rm -f ".harness/stuck-${feature}"
    rm -f ".harness/stuck-output-${feature}.log"
    rm -f ".harness/stuck-body-${feature}.md"
    rm -f ".harness/human-review-${feature}"
    rm -f ".harness/human-review-posted-${feature}"
    rm -f ".harness/human-review-body-${feature}.md"
    rm -f ".harness/sessions-${feature}.tsv"
  fi
done

# Post-merge memory (/learn) is NOT here — it runs in its own loop, watching main
# regardless of which namespace produced the merge. This loop coordinates with the
# others only through git (atomic-rename claim + branch state). (Inv 1 + 7)
